{
  "name": "project-audio",
  "description": "Web Audio laboratory for testing and playing with the Web Audio API.",
  "type": "module",
  "scripts": {
    "dev": "export BROWSER=blisk-browser && vite --host",
    "build": "tsc && vite build",
    "serve": "cd dist && php -S 0.0.0.0:8888",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist/",
    "purge": "rm -rf dist/ node_modules/"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "browserslist": [
    "defaults"
  ],
  "packageManager": "pnpm@10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f"
}
