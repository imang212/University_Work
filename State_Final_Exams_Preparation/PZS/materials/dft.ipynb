   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "f_v = 4\n",
    "T = 1/f_v \n",
    "t= np.array([0,1/4,1/2,3/4])\n",
    "s_t = np.array(5+2*np.cos(2*np.pi*t-90*np.pi/180)+3*np.cos(4*np.pi*t))\n",
    "\n",
    "plt.subplot(3,1,1)\n",
    "plt.stem(t,s_t)\n",
    "sn_numpy = np.abs(np.fft.fft(s_t))\n",
    "plt.subplot(3,1,2)\n",
    "plt.stem(t,sn_numpy)\n"
   ]
  }
